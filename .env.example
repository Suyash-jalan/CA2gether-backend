# ========================================
# CA2gether — Environment Variables
# Copy this file to .env and fill in real values
# ========================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/ca_connect
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_RETRY_INTERVAL_MS=15000
MONGO_FALLBACK_HOSTS=atlas-shard-00-00.example.mongodb.net:27017,atlas-shard-00-01.example.mongodb.net:27017,atlas-shard-00-02.example.mongodb.net:27017
MONGO_REPLICA_SET=atlas-example-shard-0

# JWT Secrets (use long random strings in production)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ICAI Number Encryption Key (32-byte hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=none

# Public API origin used for links and locally hosted uploads (no trailing slash)
PUBLIC_API_URL=http://localhost:5000

# Email (Resend HTTPS API — recommended for Render free services)
RESEND_API_KEY=
RESEND_FROM="CA2Gether <onboarding@resend.dev>"

# Optional SMTP fallback for local development or paid hosting
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="CA2gether <noreply@caconnect.com>"

# Cloudinary (required for persistent uploads on stateless production hosts;
# local development falls back to backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
